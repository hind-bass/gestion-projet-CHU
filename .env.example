# MySQL
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=itchu_manager
MYSQL_USER=itchu
MYSQL_PASSWORD=itchu_secret
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307

# Backend (Spring Boot)
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
APP_SEED_ENABLED=true

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=
VITE_PROXY_TARGET=http://localhost:3000

# IA réelle : fastapi-ai-service + Ollama en local (port 8000)
# Si le backend tourne dans Docker, utiliser : http://host.docker.internal:8000
IA_SERVICE_URL=http://localhost:8000
IA_SERVICE_INTERNAL_TOKEN=
APP_AI_ENABLED=true
OLLAMA_MODEL=llama3
